@model CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}


<H2>Shopping Cart</H2>
<div class="alert alert-info">Example checkout: an order record is saved and stock is reduced, but no payment is collected. Do not use this as a real purchase.</div>
@if (TempData["CartError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (TempData["CartSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (Model.Items.Count == 0)
{
    <p>Your example cart is empty.</p>
}
else
{
    
    <table class="table">
        <thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @item.Name @if (!item.Available) {
                        <span class="text-danger">(unavailable or insufficient stock)</span>
                    }
                </td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@item.Subtotal.ToString("C")</td>
                <td>
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<p>Current subtotal: <strong>@Model.Total.ToString("C")</strong> (tax and shipping not included).</p>
<form asp-action="Checkout" method="post">
    @foreach (var item in Model.Items)
    {
        <input type="hidden" name="quotedPrices[@item.ProductId]" value="@item.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="quotedQuantities[@item.ProductId]" value="@item.Quantity" />
    }
    <button type="submit" class="btn btn-primary" disabled="@Model.Items.Any(item => !item.Available)">Check out and reduce stock</button>
</form>
}