@model OrderPreviewViewModel

@{
    ViewData["Title"] = "Product preview";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-12">
        <h1 class="mb-4">Product preview</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <h2 class="h5">@Model.Product.Name</h2>
                        <img src="@Url.Action("Photo", "Products", new { id = Model.Product.Id })"
                             class="img-fluid rounded"
                             alt="Photo of @Model.Product.Name" />
                    </div>

                    <div class="col-md-7">
                        <h2 class="h5 mb-3">Order details</h2>
                        <div class="d-flex justify-content-between gap-3 mb-2">
                            <span>Price per item</span>
                            <span>@Model.Product.Price.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between gap-3 mb-2">
                            <span>Quantity</span>
                            <span>@Model.Quantity</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between gap-3 fw-bold">
                            <span>Subtotal</span>
                            <span>@Model.Total.ToString("C")</span>
                        </div>
                        <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3 d-flex justify-content-end">
                            <input type="hidden" name="productId" value="@Model.Product.Id" />
                            <input type="hidden" name="quantity" value="@Model.Quantity" />
                            <button type="submit" class="btn btn-primary">Add to example cart</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
