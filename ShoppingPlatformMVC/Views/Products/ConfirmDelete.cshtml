@model Product

@{
    ViewData["Title"] = "Delete product";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <h1 class="mb-4">Delete product</h1>
        <div class="card shadow-sm">
            <div class="card-body p-3 p-md-4">
                <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                <p class="text-danger">This permanently deletes the product and its photo. Unsaved edits will be lost.</p>
                <dl class="row">
                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
                    <dt class="col-sm-4">Stock</dt>
                    <dd class="col-sm-8">@Model.Stock</dd>
                </dl>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">Delete product</button>
                </form>
            </div>
        </div>
    </div>
</div>