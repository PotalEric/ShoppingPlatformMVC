@model ProductViewModel

@{
    ViewData["Title"] = "Edit";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <h1 class="mb-4">Edit product</h1>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card shadow-sm">
            <div class="card-body p-3 p-md-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row g-4">
                    <div class="col-md-5">
                        <h2 class="h5 mb-3">Current photo</h2>
                        <div class="ratio ratio-4x3 bg-light rounded mb-3">
                            <img src="@Url.Action("Photo", "Products", new { id = Model.Id })" class="object-fit-contain rounded" alt="Photo of @Model.Name" />
                        </div>
                        <div>
                            <label asp-for="Photo" class="form-label">Choose a photo (optional, JPEG or PNG, up to 5 MB)</label>
                            <input asp-for="Photo" type="file" accept="image/jpeg,image/png" class="form-control" />
                            <span asp-validation-for="Photo" class="text-danger"></span>
                            <p class="form-text">Leave blank to keep the existing photo. If validation fails, choose the photo again.</p>
                        </div>
                    </div>
                    <div class="col-md-7 d-flex flex-column">
                        <h2 class="h5 mb-3">Product details</h2>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-auto pt-3">
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete product</a>
                            <button type="submit" class="btn btn-primary px-4">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
